			"abilities": {
				"mid": [
					{
						"name": "Smeltable",
						"entries": [
							"If an aurosrath takes 5 or more fire damage from a single attack, the precious metals within their body enter a molten state until the end of their next turn. While in this state, the aurosrath takes a \u221210-foot status penalty to their Speeds, and their strikes deal an extra {@damage 1d6} fire damage. They also lose their weakness to slashing damage and their resistance to electricity damage. Finally, any creature currently {@condition grabbed|PC1} or {@condition restrained|PC1} by the aurosrath loses 1 round of air if it's holding its breath."
						]
					}
				],
				"bot": [
					{
						"name": "Fetters of Debt",
						"activity": {
							"number": 2,
							"unit": "action"
						},
						"traits": [
							"auditory",
							"curse",
							"linguistic",
							"mental",
							"occult"
						],
						"frequency": {
							"number": 1,
							"interval": 10,
							"unit": "minute"
						},
						"entries": [
							"The aurosrath bellows a plea for gold, remarking that their foes are overladen. Creatures in a 15-foot emanation must succeed at a DC 19 Will save or become {@condition encumbered|PC1} for 1 minute. The creature is aware that it can immediately end the condition by giving the aurosrath items or treasure worth at least 20 gp. Handing a held item to the aurosrath is a single {@action Interact|PC1} action. If the aurosrath's hands are full, the item falls in their space, but the condition still ends."
						]
					},
					{
						"name": "Suffocating Wealth",
						"entries": [
							"As the aurosrath holds their victim, the victim is smothered in a stream of phantom coins. A creature who begins its turn {@condition grabbed|PC1} or {@condition restrained|PC1} by an aurosrath can't speak and must hold its breath or it begins to suffocate. The coins produced are ephemeral and melt away to nothing when removed from the aurosrath's presence for more than 1 round."
						]
					}
				]
			}
		},
