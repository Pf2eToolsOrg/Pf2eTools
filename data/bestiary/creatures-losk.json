						"maxDuration": "6 rounds",
						"stages": [
							{
								"stage": 1,
								"entry": "{@damage 8d6} poison damage",
								"duration": "1 round"
							},
							{
								"stage": 2,
								"entry": "{@damage 9d6} poison damage",
								"duration": "1 round"
							},
							{
								"stage": 3,
								"entry": "{@damage 9d6} poison damage and {@condition drained|PC1|drained 1}",
								"duration": "1 round"
							}
						]
					},
					{
						"name": "Spine Volley",
						"activity": {
							"number": 2,
							"unit": "action"
						},
						"entries": [
							"The corbayrant makes four spine {@action Strike|PC1|Strikes}, each against a different target. These attacks all count toward the corbayrant's multiple attack penalty, but the penalty doesn't increase until after the corbayrant makes their attacks."
						]
					},
					{
						"name": "Swallow Whole",
						"activity": {
							"number": 1,
							"unit": "action"
						},
						"entries": [
							"Large, {@damage 9d6} piercing plus thorn paralysis, Rupture 30"
						]
					},
					{
						"name": "Thorn Paralysis",
						"traits": [
							"incapacitation",
							"poison"
						],
						"entries": [
							"The corbayrant's spines are covered in a paralyzing toxin that cause verdurous thorns to sprout from their victim's body. When a non-corbayrant creature is exposed, it attempts a DC 37 Fortitude save.",
							{
								"type": "successDegree",
								"entries": {
									"Critical Success": [
										"The creature is unaffected."
									],
									"Success": [
										"The creature sprouts spines like those of the corbayrant. For 1 minute, the creature gains the corbayrant's thorny hide ability.",
										"Allies attempting to aid the victim with touch-range spells and abilities run the risk of becoming infected themselves. At the end of the duration, the spines fall off harmlessly."
									],
									"Failure": [
										"As success, but the creature is also {@condition paralyzed|PC1} for 1 minute. It can attempt another Fortitude save at the end of each turn to end the paralysis, but not the spines."
									],
									"Critical Failure": [
										"As failure, but the creature doesn't receive a save at the end of its turn to end the paralysis."
									]
								}
							}
						]
					}
				]
			}
