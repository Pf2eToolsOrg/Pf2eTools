			"abilities": {
				"mid": [
					{
						"name": "Thorny Hide",
						"entries": [
							"A corbayrant's body is covered in jagged spines. Adjacent creatures that hit them with a melee attack, as well as creatures that touch them or hit them with an unarmed attack, take {@damage 4d6} piercing damage and are exposed to thorn paralysis."
						]
					},
					{
						"name": "Vitriolic Miasma",
						"traits": [
							"aura"
						],
						"entries": [
							"30 feet. Non-corbayrants take a \u22122 circumstance penalty to saves against {@trait poison} effects and gain weakness 10 to poison damage while within the aura."
						]
					},
					{
						"name": "Reactive Strike",
						"activity": {
							"number": 1,
							"unit": "reaction"
						}
